# Cloudflare Pages — إعدادات الكاش
# بينسخ للناتج من tools/build_dist.sh

# خدمة العامل والمانيفست: لازم يتفحصوا كل مرة، وإلا التحديث ما بيوصل
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

# الأيقونات ما بتتغيّر
/assets/icons/*
  Cache-Control: public, max-age=31536000, immutable

# لوحة التحكّم ما إلها داعي تنفهرس
/admin/*
  X-Robots-Tag: noindex, nofollow

# صور الامتحانات وصوته بيجوا من Supabase Storage برابط موقّع،
# مو من هون — فما في قاعدة إلهن.
